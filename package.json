{
  "name": "talent-db",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node api.js && next dev",
    "build": "node api.js && next build",
    "start": "node api.js && next start",
    "lint": "next lint",
    "google-token": "node scripts/get-google-refresh-token.mjs",
    "seed:portals": "node scripts/seed-portals.mjs",
    "seed:portals:cleanup": "node scripts/seed-portals.mjs --cleanup",
    "test:roles": "node scripts/test-roles.mjs",
    "test:resume": "tsx tests/resume-parser.test.ts",
    "fixtures:resume": "node tests/fixtures/make-fixtures.mjs",
    "test:e2e:register": "node tests/e2e-register-cv.mjs",
    "seed:chat": "node scripts/seed-chat.mjs",
    "seed:chat:cleanup": "node scripts/seed-chat.mjs --cleanup",
    "test:chat": "node scripts/test-chat.mjs",
    "test:e2e:chat": "node tests/e2e-chat.mjs",
    "bot:index": "tsx scripts/bot-index.ts",
    "test:bot:quality": "tsx --env-file-if-exists=.env.local tests/bot-quality.test.ts",
    "test:bot:security": "tsx --env-file-if-exists=.env.local scripts/test-bot-security.ts",
    "test:e2e:bot": "node --env-file-if-exists=.env.local tests/e2e-bot.mjs",
    "test:unit": "tsx --test tests/phone.test.ts tests/apply-rules.test.ts tests/backup-email.test.ts tests/email-analytics.test.ts tests/blog.test.ts tests/money.test.ts",
    "test:apply-rules": "node scripts/test-apply-rules.mjs",
    "test:e2e:invite": "tsx --conditions=react-server tests/e2e-portal-invite.mts",
    "test:e2e:import-invite": "tsx tests/e2e-import-invite.mts",
    "test:e2e:kpis": "tsx tests/e2e-dashboard-kpis.mts",
    "test:e2e:client-teams": "tsx tests/e2e-client-teams.mts"
  },
  "dependencies": {
    "@googleapis/drive": "^26.0.2",
    "@huggingface/transformers": "^3.8.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "fuse.js": "^7.5.0",
    "geist": "^1.7.2",
    "imapflow": "^2.4.2",
    "lenis": "^1.3.26",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "motion": "^14.0.0",
    "next": "15.5.27",
    "nodemailer": "^10.0.15",
    "papaparse": "^5.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.27",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "docx": "^9.9.0",
    "playwright-core": "^1.64.0",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "not dead"
  ]
}
